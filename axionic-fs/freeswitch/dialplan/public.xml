<extension name="STC-To-automax3">
    <condition field="destination_number" expression="^\+966112114606|9036714099$">
        <action application="set" data="dest_num=${destination_number}"/>
        <action application="log" data="INFO Routing ${dest_num} to automax3"/>
        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="set" data="call_timeout=60"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="bridge" data="sofia/internal/${destination_number}@zkff.automaxsw.com:5060;transport=tcp"/>
    </condition>
</extension>
