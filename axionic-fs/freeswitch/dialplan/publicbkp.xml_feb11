<?xml version="1.0" encoding="utf-8"?>
<!--
    NOTICE:

    This context is usually accessed via authenticated callers on the sip profile on port 5060
    or transfered callers from the public context which arrived via the sip profile on port 5080.

    Authenticated users will use the user_context variable on the user to determine what context
    they can access.  You can also add a user in the directory with the cidr= attribute acl.conf.xml
    will build the domains ACL using this value.
-->
<!-- http://wiki.freeswitch.org/wiki/Dialplan_XML -->
<include>
<context name="public">



   <extension name="codec_info" continue="true">
        <condition field="${ep_codec_string}" expression="VP8|H264|VP9">
                <action application="set" data="isvideocall=true" inline="true"/>
                <anti-action application="set" data="isvideocall=false" inline="true"/>
        </condition>
   </extension>

 <extension name="public_did">
           <condition field="destination_number" expression="^8(\d{6,12})$">
                   <!-- <action application="limit" data="hash $${domain} 966115109111 5 !NORMAL_TEMPORARY_FAILURE"/>
                   <action application="limit" data="hash $${domain} 966115109111_Daily 300/86400 !NORMAL_TEMPORARY_FAILURE"/> -->
                   <action application="set" data="sip_sticky_contact=true"/>
                                <!--<action application="bridge" data="{rtp_adv_audio_ip=172.17.1.8}sofia/gateway/newrock-vg/903$1|sofia/gateway/newrock-vg/904$1|sofia/gateway/newrock-vg/906$1"/> -->
                                <action application="bridge" data="{rtp_adv_audio_ip=10.10.10.10,absolute_codec_string='PCMU,PCMA'}sofia/gateway/newrock-vg/903$1|sofia/gateway/newrock-vg/904$1|sofia/gateway/newrock-vg/906$1"/>
     </condition>
  </extension>

 <extension name="public_did_stc-trunk">
           <condition field="destination_number" expression="^9(\d{6,12})$">
                   <!-- <action application="limit" data="hash $${domain} 966115109111 5 !NORMAL_TEMPORARY_FAILURE"/>
                   <action application="limit" data="hash $${domain} 966115109111_Daily 300/86400 !NORMAL_TEMPORARY_FAILURE"/> -->
		   <!--<action application="set" data="sip_sticky_contact=true"/> -->
		   <!--<action application="bridge" data="{rtp_adv_audio_ip=172.17.1.8}sofia/gateway/newrock-vg/903$1|sofia/gateway/newrock-vg/904$1|sofia/gateway/newrock-vg/906$1"/> -->
		   <action application="set" data="effective_caller_id_name=_undef_"/>
		   <action application="set" data="effective_caller_id_number=+966112114600"/>

		   <!--<action application="unset" data="sip_h_Remote-Party-ID"/> -->
		   <!--<action application="set" data="sip_h_from=<sip:+9661110143504@fmc.stc.com.sa>;tag=${sip_from_tag};user=phone"/>-->
			   <action application="export" data="nolocal:sip_invite_params=user=phone"/>
			   <action application="export" data="nolocal:sip_invite_from_params=user=phone"/>
			   <action application="answer"/>
                                <action application="bridge" data="{origination_caller_id_number=+966112114600,sip_invite_domain=fmc.stc.com.sa,absolute_codec_string='PCMU,PCMA'}sofia/gateway/fmc.stc.com.sa/+966$1"/>
     </condition>
  </extension>

   <extension name="public_did_stc-trunk_Lesaas">
           <condition field="destination_number" expression="^0(\d{6,12})$">
                   <!-- <action application="limit" data="hash $${domain} 966115109111 5 !NORMAL_TEMPORARY_FAILURE"/>
                   <action application="limit" data="hash $${domain} 966115109111_Daily 300/86400 !NORMAL_TEMPORARY_FAILURE"/> -->
                   <!--<action application="set" data="sip_sticky_contact=true"/> -->
                   <!--<action application="bridge" data="{rtp_adv_audio_ip=172.17.1.8}sofia/gateway/newrock-vg/903$1|sofia/gateway/newrock-vg/904$1|sofia/gateway/newrock-vg/906$1"/> -->
                   <action application="set" data="effective_caller_id_name=_undef_"/>
		   <action application="set" data="effective_caller_id_number=+966112114608"/>
                  <action application="set" data="session_in_hangup_hook=true"/>
<action application="set" data="api_hangup_hook=lua outboundhangup.lua"/>
 
			<!--<action application="unset" data="sip_h_Remote-Party-ID"/> -->
                   <!--<action application="set" data="sip_h_from=<sip:+9661110143504@fmc.stc.com.sa>;tag=${sip_from_tag};user=phone"/>-->
                           <action application="export" data="nolocal:sip_invite_params=user=phone"/>
			   <action application="export" data="nolocal:sip_invite_from_params=user=phone"/>
			    <action application="lua" data="answer.lua ${caller_id_number} ${destination_number}"/>
			   <action application="answer"/>
                                <action application="bridge" data="{execute_on_answer=lua  outbridge.lua    ${uuid},origination_caller_id_number=+966112114608,sip_invite_domain=fmc.stc.com.sa,absolute_codec_string='PCMU,PCMA'}sofia/gateway/fmc.stc.com.sa/+966$1"/>
     </condition>
  </extension>


 <extension name="public_did_stc-trunk-specialNumbers">
           <condition field="destination_number" expression="9(900|901|909)">
                   <!-- <action application="limit" data="hash $${domain} 966115109111 5 !NORMAL_TEMPORARY_FAILURE"/>
                   <action application="limit" data="hash $${domain} 966115109111_Daily 300/86400 !NORMAL_TEMPORARY_FAILURE"/> -->
                   <!--<action application="set" data="sip_sticky_contact=true"/> -->
                   <!--<action application="bridge" data="{rtp_adv_audio_ip=172.17.1.8}sofia/gateway/newrock-vg/903$1|sofia/gateway/newrock-vg/904$1|sofia/gateway/newrock-vg/906$1"/> -->
                   <action application="set" data="effective_caller_id_name=_undef_"/>
                   <action application="set" data="effective_caller_id_number=+966112114600"/>
                   <!--<action application="unset" data="sip_h_Remote-Party-ID"/> -->
                   <!--<action application="set" data="sip_h_from=<sip:+9661110143504@fmc.stc.com.sa>;tag=${sip_from_tag};user=phone"/>-->
                           <action application="export" data="nolocal:sip_invite_params=user=phone"/>
                           <action application="export" data="nolocal:sip_invite_from_params=user=phone"/>
                                <action application="bridge" data="{origination_caller_id_number=+966112114600,sip_invite_domain=fmc.stc.com.sa,absolute_codec_string='PCMU,PCMA'}sofia/gateway/fmc.stc.com.sa/+966$1"/>
     </condition>
  </extension>
  <!--<extension name="Direct-0112114609">
  <condition field="destination_number" expression="/^\+966112114609$/">
    <action application="set" data="hangup_after_bridge=true"/>
    <action application="bridge" data="[fail_on_single_reject=true]user/114@pbx.axionic.io"/>
  </condition>
</extension>-->

<extension name="test-5454">
  <condition field="destination_number" expression="^5454$" break="on-false">
    <!-- Answer the call -->
    <action application="answer"/>
<action application="lua" data="leaderTrail.lua"/>
    <!-- Play a simple welcome message (or WAV file) -->
    <!-- Or use TTS instead:
    <action application="speak" data="en-US 'Welcome to LeSaaS support, please wait while we connect you to an agent'"/> 
    -->

    <!-- Hang up after playback -->
    <action application="hangup"/>
  </condition>
</extension>


<extension name="STC-Leader-IVR">
<condition field="destination_number" expression="^\+(96611211460[0-7])$" break="on-false"/>
<!-- Mon-Fri, 9am-5pm -->
<condition wday="1-7" time-of-day="00:00-23:59" break="on-true">
  <!-- limit 3 calls to this destination number per 1 second, otherwise give congestion message -->
  <!-- <action application="limit" data="hash inbound ${destination_number} 10/1 !NORMAL_CIRCUIT_CONGESTION"/> -->
  <!-- play a message before entering the queue. -->
  <!-- hangup after successful bridge to agent -->
        <action application="set" data="fail_on_single_reject=true"/>
        <action application="set" data="continue_on_fail=true"/>
  <action application="set" data="hangup_after_bridge=true"/>
       <action application="export" data="disable_q850_reason=true"/>
  <action application="lua" data="leader-ivr.lua"/>
  <!-- queue caller -->
  <!-- if no agent was reached and using max-wait-time - send to general voicemail -->
</condition>
<condition>
	<!--<action application="limit" data="hash inbound ${destination_number} 10/1 !NORMAL_CIRCUIT_CONGESTION"/> -->
  <!-- outside business hours - play message and send to general voicemail -->
  <action application="playback" data="/usr/local/freeswitch-prod-instance/share/freeswitch/sounds/custom-ivrs/LeaderOutofOffice.wav"/>
  <action application="hangup"/>
</condition>

</extension>

<extension name="STC-LeSaaS-IVR">
	<!-- match with or without leading + -->
	<condition field="destination_number" expression="^(?:\+?966112114608|\+?966112114609|9036714099)$" break="on-false"/>
		    <!--<condition field="destination_number" expression="^\+?(966112114608|966112114609)$" break="on-false"/>-->
  <condition wday="1-7" time-of-day="00:00-23:59" break="on-true">
    <action application="set" data="caller_id_number=${caller_id_number}"/>
    <action application="set" data="destination_number=${destination_number}"/>	 
 <action application="answer"/>
<!-- play initial welcome message -->
  <action application="lua" data="timecondition.lua"/>
  <action application="set" data="hangup_after_bridge=true"/>
  <action application="set" data="session_in_hangup_hook=true"/>
  <action application="set" data="api_hangup_hook=lua hangup.lua"/>
    <action application="lua" data="activecall.lua"/> 
    <action application="set" data="fail_on_single_reject=true"/>
  <action application="set" data="continue_on_fail=true"/>
  <!-- export to prevent Q.850 cause mapping if needed -->
  <action application="export" data="disable_q850_reason=true"/>
 <action application="lua" data="answer.lua ${caller_id_number} ${destination_number}"/>
 <action application="lua" data="LeSaassupportleader-ivr.lua"/>

  <!-- Inside working hours: 09:00 - 18:00 AST (server must be set to AST or adjust if different) -->
    <!-- play short welcome (use local file path or http url). Replace path with your MP3 for production -->
    <!-- send caller to callcenter queue "lesaas_support" -->
    <!-- if callcenter returns (no agent), fall through to voicemail/fallback -->
  </condition>

  <!-- Outside working hours -->
  <condition>
    <action application="playback" data="/usr/local/freeswitch/sounds/custom-ivrs/LeSaaS_OffHours.mp3"/>
    <action application="hangup"/>
  </condition>
</extension>

<extension name="Leader-IVR">
<condition field="destination_number" expression="^(90[1-9]|910)$" break="on-false"/>
<!-- Mon-Fri, 9am-5pm -->
<condition wday="1-7" time-of-day="00:00-23:59" break="on-true">
  <!-- limit 3 calls to this destination number per 1 second, otherwise give congestion message -->
  <!--<action application="limit" data="hash inbound ${destination_number} 10/1 !NORMAL_CIRCUIT_CONGESTION"/> -->
  <!-- play a message before entering the queue. -->
  <!-- hangup after successful bridge to agent -->
        <action application="set" data="fail_on_single_reject=true"/>
	<action application="set" data="continue_on_fail=true"/>
	<action application="set" data="rtp_adv_audio_ip=10.10.10.10"/>
  <action application="set" data="hangup_after_bridge=true"/>
  <action application="export" data="disable_q850_reason=true"/>
  <action application="lua" data="leader-ivr.lua"/>
  <!-- queue caller -->
  <!-- if no agent was reached and using max-wait-time - send to general voicemail -->
</condition>
<condition>
	<!--<action application="limit" data="hash inbound ${destination_number} 10/1 !NORMAL_CIRCUIT_CONGESTION"/> -->
  <!-- outside business hours - play message and send to general voicemail -->
  <action application="playback" data="/usr/local/freeswitch-prod-instance/share/freeswitch/sounds/custom-ivrs/LeaderOutofOffice.wav"/>
  <action application="hangup"/>
</condition>

</extension>

<extension name="Jihazi-IVR">
    <condition field="destination_number" expression="^(91[1-9]|920)$">
        <action application="log" data="Received analog Call on Jihazi IVR number"/>
        <condition wday="1-7" time-of-day="00:00-23:59" break="on-true">
  <!-- limit 3 calls to this destination number per 1 second, otherwise give congestion message -->
  <!-- <action application="limit" data="hash inbound ${destination_number} 3/1 !NORMAL_CIRCUIT_CONGESTION"/> -->
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="export" data="disable_q850_reason=true"/>
	<action application="set" data="rtp_adv_audio_ip=10.10.10.10"/>
        <action application="lua" data="jihazi-ivr.lua"/>
  <!-- queue caller -->
        <action application="callcenter" data="jihazi-ivr@default"/>
  <!-- if no agent was reached and using max-wait-time - send to general voicemail -->
        <action application="playback" data="/usr/local/freeswitch-prod-instance/share/freeswitch/sounds/custom-ivrs/AgentBusy.wav"/>
        <action application="hangup"/>
        </condition>
        <condition>
		<!--   <action application="limit" data="hash inbound ${destination_number} 3/1 !NORMAL_CIRCUIT_CONGESTION"/> -->
  <!-- outside business hours - play message and send to general voicemail -->
         <action application="playback" data="/usr/local/freeswitch-prod-instance/share/freeswitch/sounds/custom-ivrs/LeaderOutofOffice.wav"/>
        <action application="hangup"/>
        </condition>
    </condition>
</extension>

<extension name="Leader_callCenter">
	<condition field="destination_number" expression="^LEADER_910$">
        <action application="log" data="SENDING IVR call to Leader call center"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="callcenter" data="leader-ivr@default"/>
        <action application="playback" data="/usr/local/freeswitch-prod-instance/share/freeswitch/sounds/custom-ivrs/AgentBusy.wav"/>
        <action application="hangup"/>
    </condition>
</extension>


<extension name="Leader_callCenter">
        <condition field="destination_number" expression="^timecondition">
        <action application="answer" />
        <action application="playback" data="/usr/local/freeswitch-prod-instance/share/freeswitch/sounds/custom-ivrs/timecondition.wav"/>
        <action application="hangup"/>
    </condition>
</extension>


<extension name="Lesaas_callCenter">
	<condition field="destination_number" expression="^LEADER_Lesaas$">
		<action application="log" data="SENDING IVR call to Leader call center"/>
	<!--        <action application="set" data="hangup_after_bridge=true"/>-->
	<action application="set" data="hangup_after_bridge=false"/>
<action application="set" data="cc_export_vars=sip_h_X-CallLogId,leg_timeout,absolute_codec_string"/>
<action application="set" data="absolute_codec_string=PCMA,PCMU"/>
<!--<action application="info"/>  -->
        <action application="callcenter" data="lesaas-ivr@default"/>
 <!--	<action application="playback" data="/usr/local/freeswitch-prod-instance/share/freeswitch/sounds/custom-ivrs/AgentBusy.wav"/>  -->
 <action application="lua" data="agentdetail.lua"/>
 <action application="hangup"/>
    </condition>
</extension>

<extension name="trunkCall">
  <condition field="destination_number" expression="^553111$">
    <action application="set" data="effective_caller_id_number=${caller_id_number}"/>
    <action application="set" data="domain_name=pbx.axionic.io"/>
    <action application="lua" data="siptrunk-ivr.lua"/>
  </condition>
</extension>
<extension name="callcenter">
    <condition field="destination_number" expression="^500$">
        <action application="lua" data="siptrunk-ivr.lua"/>
        <!--action application="callcenter" data="support@default"/>-->
    </condition>
</extension>

    <extension name="conference Start Recording">
    <condition field="destination_number" expression="^CONF_START_RECORDING$">
             <action application="log" data="INFO Starting recording..."/>
             <action application="set" data="RECORD_STEREO=true"/>
             <action application="set" data="RECORD_TOGGLE_ON_REPEAT=true"/>
             <action application="set" data="record_start_time=${strftime(%Y-%m-%d %H:%M:%S)}"/>
             <action application="export" data="nolocal:record_start_time=${strftime(%Y-%m-%d %H:%M:%S)}"/>
	     <action application="set" data="record_concat_video=true"/>
	     <action application="lua" data="codec_validate.lua"/>
	    <!--<action application="lua" data="conference_record.lua"/>-->
	    <action
         application="set"  
		    data="res=${conference conf_${sip_h_X-CallLogId} recording start $${base_dir}/recordings/call_recordings/staging/${originate_leg_uuid}_${sip_h_X-CallLogId}.${avformat}"/>
  
	    <!--<action application="recording" data="conference conf_${sip_h_X-CallLogId} recording start $${base_dir}/recordings/call_recordings/dev/${originate_leg_uuid}_conf_${sip_h_X-CallLogId}.${avformat}"/>-->
    </condition>
    </extension>
    
    <extension name="conference Stop Recording">
      <condition field="destination_number" expression="^CONF_STOP_RECORDING$">
	      <action application="log" data="INFO Stop recording [${rec_file}]"/>
	      <action application="set" data="record_stop_time=${strftime(%Y-%m-%d %H:%M:%S)}"/>
	      <action application="export" data="nolocal:record_stop_time=${strftime(%Y-%m-%d %H:%M:%S)}"/>
	      <action application="lua" data="codec_validate.lua"/>
	      <action application="set" data="res=${conference conf_${sip_h_X-CallLogId} recording stop $${base_dir}/recordings/call_recordings/staging/${originate_leg_uuid}_${sip_h_X-CallLogId}.${avformat}"/>
	      <!--<action application="lua" data="record_event.lua"/>
	      <action application="lua" data="record_count.lua"/> -->
	      <!--<action application="recording" data="conference conf_${sip_h_X-CallLogId} recording stop $${base_dir}/recordings/call_recordings/dev/${originate_leg_uuid}_conf_${sip_h_X-CallLogId}.${avformat}"/>-->
      </condition>
    </extension>


   <extension name="Meeting conference Start Recording">
    <condition field="destination_number" expression="^MEETING_START_RECORDING$">
             <action application="log" data="INFO Starting recording..."/>
             <action application="set" data="RECORD_STEREO=true"/>
             <action application="set" data="RECORD_TOGGLE_ON_REPEAT=true"/>
             <action application="set" data="record_start_time=${strftime(%Y-%m-%d %H:%M:%S)}"/>
             <action application="export" data="nolocal:record_start_time=${strftime(%Y-%m-%d %H:%M:%S)}"/>
             <action application="set" data="record_concat_video=true"/>


            <action
         application="set"
                    data="res=${conference ${room_id}_${sip_h_X-CallLogId} recording start $${base_dir}/recordings/call_recordings/${conference_uuid}_${sip_h_X-CallLogId}.wav"/>

            <!--<action application="recording" data="conference conf_${sip_h_X-CallLogId} recording start $${base_dir}/recordings/call_recordings/dev/${originate_leg_uuid}_conf_${sip_h_X-CallLogId}.${avformat}"/>-->
    </condition>
    </extension>

    <extension name="Meeting conference Stop Recording">
      <condition field="destination_number" expression="^MEETING_STOP_RECORDING$">
              <action application="log" data="INFO Stop recording [${rec_file}]"/>
              <action application="set" data="record_stop_time=${strftime(%Y-%m-%d %H:%M:%S)}"/>
              <action application="export" data="nolocal:record_stop_time=${strftime(%Y-%m-%d %H:%M:%S)}"/>
              <action application="set" data="res=${conference ${room_id}_${sip_h_X-CallLogId} recording stop $${base_dir}/recordings/call_recordings/${conference_uuid}_${sip_h_X-CallLogId}.wav"/>
              <!--<action application="lua" data="record_event.lua"/>
              <action application="lua" data="record_count.lua"/> -->
              <!--<action application="recording" data="conference conf_${sip_h_X-CallLogId} recording stop $${base_dir}/recordings/call_recordings/dev/${originate_leg_uuid}_conf_${sip_h_X-CallLogId}.${avformat}"/>-->
      </condition>
    </extension>


<extension name="transf_both_legs">
 <condition field="destination_number" expression="^grpcall_1$">
                 <!--<action application="db" data="insert/conference/$2/conf_$1"/>
                 <action application="db" data="insert/conference/$3/conf_$1"/> -->
        <action application="answer"/>
	<!--  <action application="set" data="rtp_enable_vad_out=true"/>
	<action application="set" data="rtp_enable_vad_in=true"/> -->
	<!--<action application="conference" data="conf_${sip_h_X-CallLogId}@axionic++flags{moderator}"/>-->
	<!--	<action application="conference" data="conf_${sip_h_X-CallLogId}@axionic++flags{moderator|mintwo}"/>
	-->
      <action application="conference" data="conf_${dialed_extension}@axionic++flags{moderator|mintwo}"/>
      
	<action application="log" data="SIP Call-ID in Dialplan: ${sip_call_id}"/> 
<!--action application="conference" data="conf_${sip_call_id}@axionic++flags{moderator|mintwo}"/>-->
	<!--<action application="conference" data="conf_${variable_call_uuid}@axionic++flags{moderator|mintwo}"/>-->
	<!--<action application="conference" data="conf_${create_uuid()}@axionic++flags{moderator|mintwo}"/>-->
	<!--<action application="conference" data="conf_${caller_id_number}-${strftime(%Y%m%d%H%M%S)}@axionic++flags{moderator|mintwo}"/>-->

 </condition>
</extension>



    <extension name="GROUP CALL ADD">
      <condition field="destination_number" expression="^GROUP_CALL_ADD$">
    <!-- ask caller for a number + #, collect into ${target_num} variable -->
    <action application="play_and_get_digits" data="4 11 1 5000 # '' '' target_num \d+"/>
    <action application="execute_extension" data="ADD_CALL_TO_CONF__${target_num}"/>
      </condition>
    </extension>

    <extension name="Add new OB call to conference">
      <condition field="destination_number" expression="^ASK_FOR_NUMBER__(\d+)$">
    <!-- ask caller for a number + #, collect into ${target_num} variable -->
    <action application="play_and_get_digits" data="4 11 1 5000 # ivr/ivr-enter_destination_telephone_number.wav ivr/ivr-that_was_an_invalid_entry.wav target_num \d+"/>
    <!-- add this call to the conference -->
    <action application="execute_extension" data="ADD_CALL_TO_CONF__${target_num}"/>
      </condition>
    </extension>

    <extension name="add_group_call">
    <!-- if we have a four-digit number then attempt to dial it as a user ... -->
      <condition field="destination_number" expression="^ADD_CALL_TO_CONF__(\d{4})$">
        <action application="export" data="dialed_extension=$1"/>
        <action application="log" data="dialed_extension is ${dialed_extension}"/>
        <!--<action application="lua" data="conf_control.lua"/>-->
        <action application="log" data="originate_leg_uuid=${uuid}"/>
        <!--<action application="set" data="new_uuid=${create_uuid()}" inline="true"/>
        <action application="hash" data="insert/domain-${domain_name}/last_user_$1/${new_uuid}" /> -->
              <action application="lua" data="conference_list.lua" inline="true"/>
              <!-- <action application="lua" data="add_to_groupCall.lua"/> -->
        <action application="log" data="INFO conference list =${callerIdsString}" />
        <action application="log" data="INFO groupcall header =${sip_h_X-GroupCallList}" />
        <action application="log" data="INFO callerid name header =${from_user_name}" />
        <action application="set" data="origination_caller_id_name=${from_user_name}"/>
        <action application="log" data="INFO codec string =${ep_codec_string}" />
        <action application="export" data="nolocal:codec_string=${ep_codec_string}"/>
        <condition field="${isvideocall}" expression="false" break="on-true">
                  <action application="set" data="res=${bgapi originate [sip_h_X-CallLogId=${sip_h_X-CallLogId},sip_h_X-GroupCallList=${sip_h_X-GroupCallList},origination_caller_id_number=${caller_id_number},origination_caller_id_name='${from_user_name}',codec_string='${ep_codec_string}']user/${dialed_extension}@${sip_domain_name} &conference(conf_${sip_h_X-CallLogId}@axionic)}"/>
                <anti-action application="set" data="res=${bgapi originate [sip_h_X-CallLogId=${sip_h_X-CallLogId},sip_h_X-GroupCallList=${sip_h_X-GroupCallList},origination_caller_id_number=${caller_id_number},origination_caller_id_name='${from_user_name}']user/${dialed_extension}@${sip_domain_name} &conference(conf_${sip_h_X-CallLogId}@axionic)}"/>
           </condition>
      </condition>
        </extension>


<extension name="conference_set_auto_outcall">
  <condition field="destination_number" expression="^(8888)$">
  <!--  <action application="answer"/> -->
    <action application="export" data="originate_leg_uuid=${uuid}"/>
          <!--<action application="lua" data="fire_push_notify.lua"/> -->
    <action application="log" data="INFO Received X-callLogID header =${sip_h_X-CallLogId}"/>
    <action application="export" data="nolocal:sip_h_X-CallLogId=${sip_h_X-CallLogId}"/>
    <action application="set" data="sip_h_X-CallLogId=${sip_h_X-CallLogId}"/>
    <action application="log" data="Caller Codec  [${ep_codec_string}]"/>
    <action application="export" data="nolocal:codec_string=${ep_codec_string}"/>
    <action application="log" data="INFO Received X-SendGroupCall header =${sip_h_X-SendGroupCall}"/>
    <action application="set" data="ignore_early_media=true"/>
    <action application="set" data="call_timeout=45"/>
    <action application="set" data="record_count=0" inline="true"/>
    <action application="export" data="nolocal:record_count=${record_count}"/>
          <!-- <action application="set" data="sip_h_X-isGroupCall=yes"/> -->
    <action application="set" data="conference_auto_outcall_caller_id_name=${caller_id_name}"/>
    <action application="set" data="conference_auto_outcall_caller_id_number=${caller_id_number}"/>
    <action application="set" data="conference_auto_outcall_profile=axionic"/>
          <!--<action application="set" data="conference_auto_outcall_prefix={sip_auto_answer=true inline'}"/> -->
    <action application="set" data="conference_auto_outcall_timeout=60"/>
    <action application="lua" data="sendgroupcall.lua" inline="true"/>
    <action application="conference_set_auto_outcall" data="${grpcallString}"/>
    <action application="conference" data="conf_${sip_h_X-CallLogId}@axionic++flags{mintwo}"/>
    <!-- <action application="set" data="ringback=${us-ring}"/>
    <action application="conference" data="bridge:conf_$1@simple:user/1050@fsstg.leadergroup.com,user/1051@fsstg.leadergroup.com"/> -->
  </condition>
</extension>


  <extension name="MEETINGS CALL_2">
         <condition field="destination_number" expression="^MEETING_(\d{16})$">
                 <!--<action application="db" data="insert/conference/$2/conf_$1"/>
                 <action application="db" data="insert/conference/$3/conf_$1"/> -->
                 <action application="export" data="room_id=$1"/>
                 <action application="log" data="INFO Room ID=${room_id}"/>
    <action application="log" data="INFO Received X-callLogID header =${sip_h_X-CallLogId}"/>
    <action application="export" data="nolocal:sip_h_X-CallLogId=${sip_h_X-CallLogId}"/>
    <action application="set" data="sip_h_X-CallLogId=${sip_h_X-CallLogId}"/>
        <action application="log" data="INFO Received X-Meeting ID header =${sip_h_X-MeetingId}"/>
    <action application="export" data="nolocal:sip_h_X-MeetingId =${sip_h_X-MeetingId}"/>
    <action application="set" data="sip_h_X-MeetingId=${sip_h_X-MeetingId}"/>
    <action application="export" data="nolocal:sip_h_X-MeetingName =${sip_h_X-MeetingName}"/>
    <action application="set" data="sip_h_X-MeetingName=${sip_h_X-MeetingName}"/>
             <action application="set" data="rtp_enable_vad_out=true"/>
        <action application="set" data="rtp_enable_vad_in=true"/>
                <action application="answer"/>
                <action application="conference" data="${room_id}_${sip_h_X-CallLogId}@meetings"/>
         </condition>
 </extension>

   <extension name="MEETINGS ORIGINATOR END">
     <condition field="destination_number" expression="^MEETINGS_CALL_END$">
       <action application="lua" data="meeting_origin_end.lua"/>
      </condition>
   </extension>

    <extension name="MEETINGS CALL ADD">
      <condition field="destination_number" expression="^MEETINGS_CALL_ADD$">
    <!-- ask caller for a number + #, collect into ${target_num} variable -->
   <!-- <action application="play_and_get_digits" data="4 11 1 5000 # ivr/ivr-enter_destination_telephone_number.wav ivr/ivr-that_was_an_invalid_entry.wav target_num \d+"/> -->
    <action application="play_and_get_digits" data="4 11 1 5000 # '' '' target_num \d+"/>
    <action application="execute_extension" data="ADD_CALL_TO_MEETINGS__${target_num}"/>
      </condition>
    </extension>

        <extension name="HOLD_UNHOLD">
            <condition field="destination_number" expression="^HOLD_UNHOLD$">
                <action application="log" data="Hold user Info =${channel_name}" />
                <action application="play_and_get_digits" data="2 2 1 5000 # '' '' hold_unhold_key \d+"/>
                <action application="log" data="DTMF Input = {hold_unhold_key} "/>
                <action application="lua" data="hold_unhold.lua ${hold_unhold_key}"/> -->
          </condition>
    </extension>


        <extension name="add_meetings_call">
    <!-- if we have a four-digit number then attempt to dial it as a user ... -->
            <condition field="destination_number" expression="^ADD_CALL_TO_MEETINGS__(\d{4})$" break="on-true">
        <action application="export" data="dialed_extension=$1"/>
        <action application="log" data="dialed_extension is ${dialed_extension}"/>
        <!--<action application="lua" data="conf_control.lua"/>-->
        <action application="log" data="originate_leg_uuid=${conference_uuid}"/>
        <!--<action application="set" data="new_uuid=${create_uuid()}" inline="true"/>
        <action application="hash" data="insert/domain-${domain_name}/last_user_$1/${new_uuid}" /> -->
              <action application="lua" data="meeting_list.lua" inline="true"/>
              <!-- <action application="lua" data="add_to_groupCall.lua"/> -->
        <action application="log" data="INFO conference list =${callerIdsString}" />
        <action application="log" data="INFO groupcall header =${sip_h_X-GroupCallList}" />
        <action application="log" data="INFO callerid name header =${from_user_name}" />
        <action application="set" data="origination_caller_id_name=${from_user_name}"/>
        <action application="log" data="INFO codec string =${ep_codec_string}" />
        <action application="export" data="nolocal:codec_string=${ep_codec_string}"/>
	<action application="set" data="res=${bgapi originate [sip_h_X-CallLogId=${sip_h_X-CallLogId},sip_h_X-MeetingId=${sip_h_X-MeetingId},sip_h_X-MeetingName='${sip_h_X-MeetingName}',sip_h_X-isMeeting=${sip_h_X-isMeeting},sip_h_X-GroupCallList=${sip_h_X-GroupCallList},origination_caller_id_number=${caller_id_number},origination_caller_id_name='${from_user_name}',room_id=${room_id},codec_string='${ep_codec_string}']user/${dialed_extension}@${sip_domain_name} &conference(${room_id}_${sip_h_X-CallLogId}@meetings)}"/>
      </condition>
        </extension>
<extension name="bridge_to_9999">
	<condition field="destination_number" expression="^9999$">
		<action application="set" data="session_in_hangup_hook=true"/>
<action application="set" data="api_hangup_hook=lua hangup.lua"/>
    <action application="answer"/>
    <action application="sleep" data="500"/>
    <action application="bridge" data="user/9999@${domain_name}"/>
  </condition>
</extension>


	<extension name="Local_Extension_and_group_call">
	<action application="log" data="Extra Headers X-CallLogID [${sip_h_X-CallLogId}]"/>
	<!--<condition field="destination_number" expression="(^1\d{3}$|^1\d{2}$|^2\d{3}$|^3\d{3}$|^4\d{3}$)">-->
		<condition field="destination_number" expression="(^1\d{3}$|^1\d{2}$|^2\d{2}$|^3\d{2}$|^4\d{2}$|^6\d{2}$|^5\d{2}$)">
       <action application="export" data="dialed_extension=$1"/>
       <!--action application="lua" data="fire_push_notify_SIP.lua"/>-->
    
   <action application="lua" data="fire.lua"/>
               <!--<action application="lua" data="fire_cdr_event.lua"/>-->
       <action application="set" data="ringback=${us-ring}"/>
       <action application="set" data="call_timeout=45"/>
       <action application="export" data="originate_leg_uuid=${uuid}"/>
       <action application="hash" data="insert/${sip_domain_name}-call_return/${dialed_extension}/${caller_id_number}"/>
       <action application="hash" data="insert/${sip_domain_name}-last_dial_ext/${dialed_extension}/${uuid}"/>
       <action application="log" data="Extra Headers X-CallLogID [${sip_h_X-CallLogId}]"/>
       <action application="export" data="nolocal:sip_h_X-CallLogId=${sip_h_X-CallLogId}"/>
       <action application="set" data="sip_h_X-CallLogId=${sip_h_X-CallLogId}" inline="true"/>
       <action application="log" data="Caller Codec  [${ep_codec_string}]"/>
       <action application="export" data="nolocal:codec_string=${ep_codec_string}"/>
       <action application="set" data="effective_caller_id_number=${caller_id_number}"/>
       <action application="set" data="effective_caller_id_name=${caller_id_name}"/>
       <!--       <action application="set" data="fail_on_single_reject=true"/>-->
       <action application="set" data="continue_on_fail=true"/>
       <action application="set" data="hangup_after_bridge=true"/>
       <action application="set" data="record_count=0" inline="true"/>
       <!--  <action application="set" data="rtp_enable_vad_out=true"/>
	<action application="set" data="rtp_enable_vad_in=true"/> -->
               <!--<action application="bind_digit_action" data="moderator,*1,exec:execute_extension,ASK_FOR_NUMBER__$1 XML public"/>-->
       <action application="digit_action_set_realm" data="moderator"/>
       <action application="export" data="nolocal:record_count=${record_count}"/>
       <action application="export" data="disable_q850_reason=true"/>
       <action application="jitterbuffer" data="60:200:20"/>
       <!--<action application="export" data="nolocal:jitterbuffer_msec=20"/> -->
       <action application="set" data="execute_on_answer=transfer -both grpcall_1 XML public"/> 
       <!--
       <action application="bridge" data="[fail_on_single_reject=true]user/${dialed_extension}@${sip_domain_name}" /> -->
       <action application="bridge" data="[fail_on_single_reject=true,ignore_early_media=true]user/${dialed_extension}@${sip_domain_name}" />
       <action application="set" data="call_timeout=20"/>
               <!--<action application="conference" data="bridge:conf_${sip_h_X-CallLogId}@simple:[continue_on_fail=true]user/${dialed_extension}@${sip_domain_name}"/>-->
	       <!--  <action application="unset" data="execute_on_answer"/> -->
	       <action application="log" data="bridge_hangup_cause: ${bridge_hangup_cause}, hangup_cause: ${hangup_cause}"/>
	       <action application="log" data="DEBUG: originate_disposition is: ${originate_disposition}"/>
       </condition>

	<condition field="originate_disposition" expression="^(NO_ANSWER|ORIGINATOR_CANCEL|USER_BUSY|CALL_REJECTED|NONE)$">
  <action application="log" data="Originate disposition: ${originate_disposition}, sending missed call notification"/>
  <action application="set" data='voicemail_json={\"domain\":\"${sip_domain_name}\",\"port\":\"${sip_port}\",\"callerId\":\"${caller_id_number}\",\"receivers\":[\"${dialed_extension}\"],\"mediaType\":\"${media_type}\",\"callType\":\"${call_type}\",\"status\":\"Missed\"}'/>
  <action application="curl" data="https://wapis.discretal.com/calls/sip-call-notification content-type application/JSON post ${voicemail_json} ssl-verifyhost 0 ssl-verifypeer 0"/>
  <action application="sleep" data="1000"/>
  <action application="answer"/>
  <action application="sleep" data="500"/>
  <action application="voicemail" data="default ${sip_domain_name} ${dialed_extension}"/>
</condition>
</extension>



<!--        <condition field="bridge_hangup_cause" expression="^(NO_ANSWER|ORIGINATOR_CANCEL|USER_BUSY|CALL_REJECTED)$">
    <action application="log" data="Call failed with cause: ${bridge_hangup_cause}, sending missed call notification"/>
	       <action application="set" data='voicemail_json={\"domain\":\"${sip_domain_name}\",\"port\":\"${sip_port}\",\"callerId\":\"${caller_id_number}\",\"receivers\":[\"${dialed_extension}\"],\"mediaType\":\"${media_type}\",\"callType\":\"${call_type}\",\"status\":\"Missed\"}'/>
              <action application="curl" data="https://wapis.discretal.com/calls/sip-call-notification content-type application/JSON post ${voicemail_json} ssl-verifyhost 0 ssl-verifypeer 0"/>

                <action application="answer"/>
        <action application="voicemail" data="default ${sip_domain_name} ${dialed_extension}"/>
        </condition>
	</extension>

    <extension name="setup bind_digit_action_recording">
     <condition field="destination_number" expression="^SETUP_RECORDING$">
       <action application="log" data="INFO Configuring bind_digit_action to do recording on this session..."/>
       <action application="bind_digit_action" data="start_recording,*31,exec:execute_extension,START_RECORDING XML public"/>
       <action application="bind_digit_action" data="stop_recording,*32,exec:execute_extension,STOP_RECORDING XML public"/>
       <action application="digit_action_set_realm" data="start_recording"/>
    </condition>
    </extension>-->

    <extension name="bind_digit_action Start Recording">
     <condition field="destination_number" expression="^START_RECORDING$">
       <action application="log" data="INFO Starting recording..."/>
       <action application="lua" data="codec_validate.lua"/>
       <!--<action application="set" data="RECORD_APPEND=true"/>-->
       <action application="set" data="record_concat_video=true"/>
       <action application="export" data="RECORD_STEREO=true"/>
       <action application="export" data="RECORD_TOGGLE_ON_REPEAT=true"/>
       <action application="set" data="record_start_time=${strftime(%Y-%m-%d %H:%M:%S)}" inline="true"/>
       <action application="export" data="nolocal:record_start_time=${strftime(%Y-%m-%d %H:%M:%S)}"/>
       <action application="log" data="Call AV format details [${avformat}]"/>
       <action
         application="set"
         inline="true"
                data="rec_file=$${base_dir}/recordings/call_recordings/${uuid}_${caller_id_number}_${dialed_user}_${sip_h_X-CallLogId}"
       />
       <action application="record_session" data="${rec_file}.${avformat}"/>
       <action application="digit_action_set_realm" data="stop_recording"/>
     </condition>
    </extension>

    <extension name="bind_digit_action Stop Recording">
      <condition field="destination_number" expression="^STOP_RECORDING$">
        <action application="log" data="INFO Stop recording [${rec_file}]"/>
        <action application="stop_record_session" data="${rec_file}.${avformat}"/>
        <action application="digit_action_set_realm" data="start_recording"/>
      </condition>
    </extension>

    <X-PRE-PROCESS cmd="include" data="default/*.xml"/>

  </context>
</include>
