<extension name="STC-Leader-IVR">
<condition field="destination_number" expression="^\+(96611211460[0-9])$" break="on-false"/>
<!-- Mon-Fri, 9am-5pm -->
<condition wday="1-7" time-of-day="00:00-23:59" break="on-true">
  <!-- limit 3 calls to this destination number per 1 second, otherwise give congestion message -->
  <action application="limit" data="hash inbound ${destination_number} 10/1 !NORMAL_CIRCUIT_CONGESTION"/>
  <!-- play a message before entering the queue. -->
  <!-- hangup after successful bridge to agent -->
        <action application="set" data="fail_on_single_reject=true"/>
        <action application="set" data="continue_on_fail=true"/>
  <action application="set" data="hangup_after_bridge=true"/>
       <action application="export" data="disable_q850_reason=true"/>
  <action application="lua" data="leader-ivr.lua"/>
  <!-- queue caller -->
  <!-- if no agent was reached and using max-wait-time - send to general voicemail -->
</condition>
<condition>
  <action application="limit" data="hash inbound ${destination_number} 10/1 !NORMAL_CIRCUIT_CONGESTION"/>
  <!-- outside business hours - play message and send to general voicemail -->
  <action application="playback" data="/usr/local/freeswitch-prod-instance/share/freeswitch/sounds/custom-ivrs/LeaderOutofOffice.wav"/>
  <action application="hangup"/>
</condition>

</extension>
 

