local access_token = session:getVariable("access_token")

-- only fetch if missing
if not access_token then
    local token_json, err = get_token()

    if token_json then
        local data = json.decode(token_json)

        if data and data["data"] and data["data"]["token"] then
            access_token = tostring(data["data"]["token"])

            freeswitch.consoleLog("INFO",
                "Access Token fetched: " .. access_token .. "\n")

            session:setVariable("access_token", access_token)
        else
            freeswitch.consoleLog("ERR", "Token not found in response\n")
        end
    else
        freeswitch.consoleLog("ERR", "get_token() failed: " .. tostring(err) .. "\n")
    end
end

local function is_extension(number)
    return number ~= nil and #number <= 4  -- adjust threshold to your setup
end
