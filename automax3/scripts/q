function table_to_json(tbl)
    local json = "{"
    local first = true
    for k, v in pairs(tbl) do
        if not first then json = json .. "," end
        json = json .. string.format('"%s":"%s"', k, v)
        first = false
    end
    json = json .. "}"
    return json
end

