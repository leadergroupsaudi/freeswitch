-- Use FreeSWITCH API to make the call with Accept header
local curl_cmd = string.format(
    "%s%s content-type application/json -H 'Authorization: Bearer %s' -H 'Accept: application/json' post '%s'",
    api_url,
    access_token,
    access_token,
    json_payload
)

