if recfilename then
    file_path = "/usr/local/freeswitch/recordings/" .. recfilename

    -- ⛔ Don't upload if call record doesn't exist in EPM
    local end_decoded = json.decode(response)
    if not end_decoded or end_decoded["success"] == false then
        freeswitch.consoleLog("ERR", "[upload] Skipping upload — call record not found in EPM: " .. tostring(end_decoded and end_decoded["error"]) .. "\n")
        os.execute("rm -f " .. file_path)
        return
    end

    -- ✅ Call record exists, safe to upload
    local recording_file = io.open(file_path, "rb")
    if recording_file then
        local file_data = recording_file:read("*all")
        recording_file:close()

        local boundary = "----LuaBoundary" .. call_uuid
        local filename = recfilename

        local body = "--" .. boundary .. "\r\n"
            .. 'Content-Disposition: form-data; name="file"; filename="' .. filename .. '"' .. "\r\n"
            .. "Content-Type: audio/wav\r\n\r\n"
            .. file_data .. "\r\n"
            .. "--" .. boundary .. "--\r\n"

        local attach_response = {}
        -- 👇 Add ?token= just like your /end endpoint
        local attach_url = "https://epmstg.automaxsw.com/api/v1/calls/" .. call_uuid .. "/attachments?token=" .. access_token

        local res, code, headers = http.request({
            url = attach_url,
            method = "POST",
            headers = {
                ["Authorization"] = "Bearer " .. access_token,
                ["Content-Type"] = "multipart/form-data; boundary=" .. boundary,
                ["Content-Length"] = #body,
                ["Accept"] = "application/json, text/plain, */*",
            },
            source = ltn12.source.string(body),
            sink = ltn12.sink.table(attach_response),
        })

        freeswitch.consoleLog("INFO", "[upload] Response code: " .. tostring(code) .. "\n")
        freeswitch.consoleLog("INFO", "[upload] Response body: " .. table.concat(attach_response) .. "\n")
    else
        freeswitch.consoleLog("ERR", "[upload] Could not open file: " .. file_path .. "\n")
    end

    freeswitch.consoleLog("INFO", "Deleting recording: " .. tostring(file_path) .. "\n")
    os.execute("rm -f " .. file_path)
end
-- Simple JSON builder (safe for this payload)
function table_to_json(tbl)
    local json = "{"
    local first = true
    for k, v in pairs(tbl) do
        if not first then json = json .. "," end
        json = json .. string.format('"%s":"%s"', k, v)
        first = false
    end
    json = json .. "}"
    return json
end
