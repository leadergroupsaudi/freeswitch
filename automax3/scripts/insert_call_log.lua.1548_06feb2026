---------------  call log (using luasocket - RECOMMENDED) ----------------------------------
local payload = {
    call_uuid = call_uuid,
    created_by = created_by,
    status = call_status,
    start_at = start_at,
    participants = participants,
    joined_users = joined_users,
    invited_users = invited_users
}

local json_payload = encode_json(payload)
freeswitch.consoleLog("INFO", "JSON Payload: " .. json_payload .. "\n")

local api_url = "https://ax3.automaxsw.com/api/v1/admin/call-logs"

-- Use LuaSocket HTTPS
local https = require("ssl.https")
local ltn12 = require("ltn12")

local response_body = {}

local res, code, response_headers, status = https.request{
    url = api_url,
    method = "POST",
    headers = {
        ["Content-Type"] = "application/json",
        ["Authorization"] = "Bearer " .. access_token,
        ["Content-Length"] = #json_payload,
        ["Accept"] = "application/json"
    },
    source = ltn12.source.string(json_payload),
    sink = ltn12.sink.table(response_body)
}

local response_text = table.concat(response_body)

freeswitch.consoleLog("INFO", "HTTP Status Code: " .. tostring(code) .. "\n")
freeswitch.consoleLog("INFO", "Response Body: " .. response_text .. "\n")

if code == 200 or code == 201 then
    local success, decoded = pcall(json.decode, response_text)

    if success and decoded then
        -- Adjust based on your Fiber response structure
        local callLogID = decoded.id or (decoded.data and decoded.data.id)

        if callLogID then
            freeswitch.consoleLog("INFO", "Successfully created call log with ID: " .. callLogID .. "\n")
            api:executeString("uuid_setvar " .. uuid .. " callLogID " .. callLogID)
        else
            freeswitch.consoleLog("WARNING", "Call log created but no ID found in response\n")
        end
    else
        freeswitch.consoleLog("ERR", "Failed to parse response JSON: " .. tostring(decoded) .. "\n")
    end
else
    freeswitch.consoleLog("ERR", "API request failed with status " .. tostring(code) .. "\n")
    freeswitch.consoleLog("ERR", "Response: " .. response_text .. "\n")
end
