-- ================== Helpers ==================

local function safe(v)
    if v == nil or v == "" then
        return nil
    end
    return v
end

local function to_iso(ts)
    if not ts or ts == "" then
        return nil
    end
    return tostring(ts):gsub(" ", "T") .. "Z"
end

local function encode_json(data)
    local function esc(s)
        s = tostring(s)
        s = s:gsub("\\", "\\\\"):gsub('"', '\\"')
        return '"' .. s .. '"'
    end

    local function arr(t)
        local o = {}
        for _, v in ipairs(t) do
            table.insert(o, type(v) == "number" and v or esc(v))
        end
        return "[" .. table.concat(o, ",") .. "]"
    end

    local function obj(t)
        local o = {}
        for k, v in pairs(t) do
            if v ~= nil then
                local val
                if type(v) == "table" then
                    val = arr(v)
                elseif type(v) == "number" then
                    val = v
                else
                    val = esc(v)
                end
                table.insert(o, esc(k) .. ":" .. val)
            end
        end
        return "{" .. table.concat(o, ",") .. "}"
    end

    return obj(data)
end

-- ================== Participants ==================

local participants = {}
if tonumber(callee) then
    table.insert(participants, tostring(callee))
end
if tonumber(caller) then
    table.insert(participants, tostring(caller))
end

-- ================== Joined / Invited ==================

local joined_users = {}
local invited_users = {}

local answered = session:getVariable("answertime")

if answered and answered ~= "" then
    table.insert(joined_users, tostring(callee))
else
    table.insert(invited_users, tostring(callee))
end

-------------------authentication -------------------------
-- STEP 1: GET BEARER TOKEN
local function get_token()
    local api = freeswitch.API()
    local payload = '{"email":"admin@automax.com","password":"admin123"}'
    
    local curl_cmd = "https://ax3.automaxsw.com/api/v1/auth/login content-type application/json post " .. payload
    
    freeswitch.consoleLog("INFO", "Executing: curl " .. curl_cmd .. "\n")
    
    local result = api:executeString("curl " .. curl_cmd)
    
    freeswitch.consoleLog("INFO", "CURL Result: " .. tostring(result) .. "\n")
    
    return result
end

