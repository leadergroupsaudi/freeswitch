local function to_utc_string(epoch)
    epoch = tonumber(epoch)
    if not epoch or epoch <= 0 then return "NONE" end
    if epoch > 9999999999 then epoch = math.floor(epoch / 1000) end
    return os.date("!%Y-%m-%dT%H:%M:%SZ", epoch)
end
