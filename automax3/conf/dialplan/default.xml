<action application="set" data="bridge_pre_execute_bleg_data=ivr_outbridge.lua ${uuid}"/>

<action application="callcenter" data="ccm-transfer@default"/>
    <action application="stop_record_session" data="all" />
    <action application="set" data="sip_h_X-UUID=${uuid}" />
