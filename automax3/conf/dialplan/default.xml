    <extension name="Local_Extension">
        <!--<condition field="destination_number" expression="^(10[0-9][0-9])$">-->

        <condition field="destination_number" expression="(^99999999999999999999999999$)">
			<!--<condition field="destination_number" expression="(^1\d{3}$|^1\d{2}$|^2\d{3}$|^3\d{3}$|^4\d{3}$)">  -->
        <action application="export" data="dialed_extension=$1"/>
                <!--<action application="lua" data="fire_push_notify.lua"/>-->
        <!--<action application="sleep" data="10000"/>-->
        <!--<action application="export" data="nolocal:execute_on_ring=lua fire_push_notify.lua"/>-->
        <!-- bind_meta_app can have these args <key> [a|b|ab] [a|b|o|s] <app> -->
        <action application="bind_meta_app" data="1 b s execute_extension::dx XML features"/>
        <action application="bind_meta_app" data="2 b s record_session::$${recordings_dir}/${caller_id_number}.${strftime(%Y-%m-%d-%H-%M-%S)}.wav"/>
        <action application="bind_meta_app" data="3 b s execute_extension::cf XML features"/>
        <action application="bind_meta_app" data="4 b s execute_extension::att_xfer XML features"/>
        <action application="set" data="ringback=${us-ring}"/>
