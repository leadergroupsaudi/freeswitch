<extension name="callCenter transfer call to available agent">
    <condition field="destination_number" expression="^(9036714099)$">
        <action application="set" data="rtp_secure_media=false"/>
        <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
        <action application="log" data="INFO SENDING IVR call to call center"/>
        <action application="set" data="sip_h_X-CallLogId=${sip_h_X-CallLogId}" inline="true"/>
        <action application="set" data="leg_timeout=60"/>
        <action application="set" data="hangup_after_bridge=false"/>
        <action application="set" data="continue_on_fail=true"/>
        <action application="bridge" data="${sofia_contact(8888)}"/>
        <action application="log" data="WARNING Bridge to agent 8888 failed, no agents available"/>
        <action application="hangup" data="NO_ANSWER"/>
    </condition>
</extension>


<extension name="callCenter transfer call to available agent">
        <condition field="destination_number" expression="^(OPCODE_101|14000)$">
	       <action application="answer"/>
<action application="set" data="rtp_secure_media=false"/>
<action application="set" data="absolute_codec_string=PCMU,PCMA"/>
                <action application="log" data="SENDING IVR call to call center"/>
        <action application="set" data="hangup_after_bridge=false"/>
        <action application="set" data="sip_h_X-CallLogId=${sip_h_X-CallLogId}" inline="true"/>
        <action application="set" data="absolute_codec_string=PCMA,PCMU"/>
        <action application="set" data="leg_timeout=20"/>
        <action application="transfer" data="direct_agent"/>
      </condition>
  </extension>

<extension name="callCenter route">
  <condition field="destination_number" expression="^direct_agent$">

    <action application="log" data="SENDING IVR call to call center" />
    <action application="set" data="absolute_codec_string=PCMA,PCMU" />
    <action application="set" data="leg_timeout=20" />
      <action application="unset" data="execute_on_hangup"/>
<action application="set" data="session_in_hangup_hook=true"/>
<action application="set" data="api_hangup_hook=lua ivr_hangup.lua ${uuid}"/>
	  <!--	  <action application="callcenter" data="ccm-ivr@default" /> -->
   <action application="set" data="hangup_after_bridge=false"/>
   <action application="set" data="recfilename=${uuid}.wav"/>
   <!--
   <action application="set" data="bridge_pre_execute_bleg_app=record_session"/>
<action application="set" data="bridge_pre_execute_bleg_data=$${base_dir}/recordings/${recfilename}"/>
   -->
