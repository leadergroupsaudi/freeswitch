<extension name="saudi_outbound">
  <condition field="destination_number" expression="^(?:\+?966|00966)?0?(\d{8,9})$">
	  <action application="set" data="dial_number=$1"/>
	  <action application="set" data="session_in_hangup_hook=true"/>
	  <action application="set" data="ringback=%(2000,4000,440.0,480.0)"/>
    <action application="set" data="effective_caller_id_number=+966112114606"/>
    <action application="set" data="origination_caller_id_number=+966112114606"/>
    <action application="set" data="api_hangup_hook=lua outboundhangup.lua ${uuid}"/>
    <action application="lua" data="insert_call_log.lua ${uuid} ${destination_number}"/>
    <action application="lua" data="status.lua ${uuid} ${destination_number}"/>  
    <action application="set" data="recording_follow_transfer=true"/>
    <action application="set" data="recfilename=${uuid}.wav"/>
    <action application="record_session" data="$${base_dir}/recordings/${recfilename}"/>
    <action application="export" data="sip_h_X-Call-UUID=${uuid}"/>
    <action application="set" data="call_uuid=${uuid}"/>
    <action application="set" data="sip_copy_custom_headers=true"/>
    <action application="set" data="sip_h_X-EPM940-UUID=${uuid}"/>
    <action application="export" data="sip_h_X-EPM940-UUID=${uuid}"/>
    <action application="set" data="hangup_after_bridge=true"/>
    <action application="set" data="absolute_codec_string=PCMU,PCMA"/>
    <action application="set" data="ignore_early_media=true"/>
    <action application="ring_ready"/>
    <action application="log" data="INFO Outbound Saudi Call normalized -> +966${dial_number}"/>
    <action application="bridge" data="{execute_on_answer='lua outbridge.lua ${uuid} ${destination_number}',sip_invite_domain=fmc.stc.com.sa,absolute_codec_string=PCMU,PCMA}sofia/gateway/saudi_stc/+966${dial_number}"/>

