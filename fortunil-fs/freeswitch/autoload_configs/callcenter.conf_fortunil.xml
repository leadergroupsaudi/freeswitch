        <agent name="1003" type="callback" contact="[absolute_codec_string='PCMU,PCMA',leg_timeout=30]user/1003@leaderfs.axionic.io" status="Available" max-no-answer="2" wrap-up-time="2" reject-delay-time="20" busy-delay-time="20" />
	<agent name="1004" type="callback" contact="[absolute_codec_string='PCMU,PCMA',leg_timeout=30]user/1004@leaderfs.axionic.io" status="Available" max-no-answer="2" wrap-up-time="2" reject-delay-time="20" busy-delay-time="20" />
        <agent name="1005" type="callback" contact="[absolute_codec_string='PCMU,PCMA',leg_timeout=30]user/1005@leaderfs.axionic.io" status="Available" max-no-answer="2" wrap-up-time="2" reject-delay-time="20" busy-delay-time="20" />
        <agent name="1006" type="callback" contact="[absolute_codec_string='PCMU,PCMA',leg_timeout=30]user/1006@leaderfs.axionic.io" status="Available" max-no-answer="2" wrap-up-time="2" reject-delay-time="20" busy-delay-time="20" />
        <agent name="1007" type="callback" contact="[absolute_codec_string='PCMU,PCMA',leg_timeout=30]user/1007@leaderfs.axionic.io" status="Available" max-no-answer="2" wrap-up-time="2" reject-delay-time="20" busy-delay-time="20" />
        <agent name="1008" type="callback" contact="[absolute_codec_string='PCMU,PCMA',leg_timeout=30]user/1008@leaderfs.axionic.io" status="Available" max-no-answer="2" wrap-up-time="2" reject-delay-time="20" busy-delay-time="20" />
        <agent name="1009" type="callback" contact="[absolute_codec_string='PCMU,PCMA',leg_timeout=30]user/1009@leaderfs.axionic.io" status="Available" max-no-answer="2" wrap-up-time="2" reject-delay-time="20" busy-delay-time="20" />
        <agent name="1010" type="callback" contact="[absolute_codec_string='PCMU,PCMA',leg_timeout=30]user/1010leaderfs.axionic.io" status="Available" max-no-answer="2" wrap-up-time="2" reject-delay-time="20" busy-delay-time="20" />
  </agents>
  <tiers>
        <tier agent="1000" queue="ccm-ivr@default" level="1" position="1"/>
        <tier agent="1001" queue="ccm-ivr@default" level="1" position="1"/>
        <tier agent="1002" queue="ccm-ivr@default" level="1" position="1"/>
        <tier agent="1003" queue="ccm-ivr@default" level="1" position="1"/>
        <tier agent="1004" queue="ccm-ivr@default" level="1" position="1"/>
        <tier agent="1005" queue="ccm-ivr@default" level="1" position="1"/>
        <tier agent="1006" queue="ccm-ivr@default" level="1" position="1"/>
        <tier agent="1007" queue="ccm-ivr@default" level="1" position="1"/>
        <tier agent="1008" queue="ccm-ivr@default" level="1" position="1"/>
        <tier agent="1009" queue="ccm-ivr@default" level="1" position="1"/>
        <tier agent="1010" queue="ccm-ivr@default" level="1" position="1"/>
