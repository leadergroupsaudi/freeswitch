<?php
error_reporting(E_ALL);
ini_set('display_errors', 1);

$conn = new mysqli("localhost", "phpuser", "php123", "pbx_user");
if ($conn->connect_error) {
    http_response_code(500);
    die(json_encode(['success' => false, 'message' => 'DB connection failed']));
}

header('Content-Type: application/json');

// Support JSON + POST + GET
$data = json_decode(file_get_contents("php://input"), true);

$action    = $data['action']    ?? $_POST['action']    ?? $_GET['action']    ?? '';
$extension = $data['extension'] ?? $_POST['extension'] ?? $_GET['extension'] ?? '';
$password  = $data['password']  ?? $_POST['password']  ?? $_GET['password']  ?? '';
$caller_id_name      = $data['caller_id_name']      ?? $_POST['caller_id_name']      ?? $_GET['caller_id_name']      ?? '';

$fs_path = "/usr/local/freeswitch-automax-instance/etc/freeswitch/directory/leaderfs.axionic.io/" . $extension . ".xml";

// ============================================
// HELPERS
// ============================================
function extensionExists($conn, $extension) {
    $stmt = $conn->prepare("SELECT id FROM extensions WHERE extension = ?");
    $stmt->bind_param("s", $extension);
    $stmt->execute();
    $stmt->store_result();
    $exists = $stmt->num_rows > 0;
    $stmt->close();
    return $exists;
}

function getExtension($conn, $extension) {
    $stmt = $conn->prepare("SELECT extension, password, name FROM extensions WHERE extension = ?");
    $stmt->bind_param("s", $extension);
    $stmt->execute();
    $result = $stmt->get_result();
    $row    = $result->fetch_assoc();
    $stmt->close();
    return $row;
}

function buildXml($extension, $password, $name) {
    return "<include>
<user id=\"$extension\">
<params>
<param name=\"password\" value=\"$password\"/>
<param name=\"vm-password\" value=\"$password\"/>
</params>
<variables>
<variable name=\"toll_allow\" value=\"domestic,international,local\"/>
<variable name=\"accountcode\" value=\"$extension\"/>
<variable name=\"effective_caller_id_name\" value=\"$name\"/>
<variable name=\"effective_caller_id_number\" value=\"$extension\"/>
<variable name=\"outbound_caller_id_name\" value=\"$name\"/>
<variable name=\"outbound_caller_id_number\" value=\"$extension\"/>
</variables>
</user>
</include>";
}

// ============================================
// CREATE
// ============================================
if ($action == "create") {

    if (empty($extension) || empty($password) || empty($name)) {
        http_response_code(400);
        echo json_encode([
            'success' => false,
            'message' => "extension, password and name are required"
        ]);
        exit;
    }

    if (extensionExists($conn, $extension)) {
        http_response_code(409);
        echo json_encode([
            'success' => false,
            'message' => "Extension $extension already exists. Use action=update to modify it."
        ]);
        exit;
    }

    // Insert into DB
    $stmt = $conn->prepare("INSERT INTO extensions (extension, password, name) VALUES (?, ?, ?)");
    $stmt->bind_param("sss", $extension, $password, $name);

    if (!$stmt->execute()) {
        http_response_code(500);
        echo json_encode([
            'success' => false,
            'message' => "DB insert failed: " . $stmt->error
        ]);
        exit;
    }
    $stmt->close();

    // Write XML file
    if (file_put_contents($fs_path, buildXml($extension, $password, $name)) === false) {
        // Rollback — delete from DB
        $rollback = $conn->prepare("DELETE FROM extensions WHERE extension = ?");
        $rollback->bind_param("s", $extension);
        $rollback->execute();
        $rollback->close();

        http_response_code(500);
        echo json_encode([
            'success'  => false,
            'message'  => "Failed to write XML file for extension $extension. DB entry rolled back.",
            'rollback' => true
        ]);
        exit;
    }

    // Reload FreeSWITCH
    $fs_reload = shell_exec("/bin/fs_cli_automax --port 8022 -x 'reloadxml' 2>&1");

    http_response_code(201);
    echo json_encode([
        'success'    => true,
        'message'    => "Extension $extension created successfully",
        'extension'  => $extension,
        'name'       => $name,
        'freeswitch' => trim($fs_reload)
    ]);
}

// ============================================
// UPDATE
// ============================================
elseif ($action == "update") {

    if (empty($extension)) {
        http_response_code(400);
        echo json_encode([
            'success' => false,
            'message' => "extension is required"
        ]);
        exit;
    }

    if (!extensionExists($conn, $extension)) {
        http_response_code(404);
        echo json_encode([
            'success' => false,
            'message' => "Extension $extension not found. Use action=create to add it."
        ]);
        exit;
    }

    $existing     = getExtension($conn, $extension);
    $new_password = !empty($password) ? $password : $existing['password'];
    $new_name     = !empty($name)     ? $name     : $existing['name'];

    $changed = [];
    if ($new_password !== $existing['password']) $changed[] = 'password';
    if ($new_name     !== $existing['name'])     $changed[] = 'name';

    if (empty($changed)) {
        http_response_code(400);
        echo json_encode([
            'success' => false,
            'message' => "Nothing to update - same values provided for extension $extension"
        ]);
        exit;
    }

    // Update DB
    $stmt = $conn->prepare("UPDATE extensions SET password = ?, name = ? WHERE extension = ?");
    $stmt->bind_param("sss", $new_password, $new_name, $extension);

    if (!$stmt->execute()) {
        http_response_code(500);
        echo json_encode([
            'success' => false,
            'message' => "DB update failed: " . $stmt->error
        ]);
        exit;
    }
    $stmt->close();

    // Write XML file
    if (file_put_contents($fs_path, buildXml($extension, $new_password, $new_name)) === false) {
        // Rollback — restore old values in DB
        $rollback = $conn->prepare("UPDATE extensions SET password = ?, name = ? WHERE extension = ?");
        $rollback->bind_param("sss", $existing['password'], $existing['name'], $extension);
        $rollback->execute();
        $rollback->close();

        http_response_code(500);
        echo json_encode([
            'success'  => false,
            'message'  => "Failed to write XML file for extension $extension. DB rolled back to previous values.",
            'rollback' => true
        ]);
        exit;
    }

    // Reload FreeSWITCH
    $fs_reload = shell_exec("/bin/fs_cli_automax --port 8022 -x 'reloadxml' 2>&1");

    http_response_code(200);
    echo json_encode([
        'success'    => true,
        'message'    => "Extension $extension updated successfully",
        'extension'  => $extension,
        'updated'    => $changed,
        'name'       => $new_name,
        'password'   => $new_password,
        'freeswitch' => trim($fs_reload)
    ]);
}

// ============================================
// DELETE
// ============================================
elseif ($action == "delete") {

    if (empty($extension)) {
        http_response_code(400);
        echo json_encode([
            'success' => false,
            'message' => "extension is required"
        ]);
        exit;
    }

    if (!extensionExists($conn, $extension)) {
        http_response_code(404);
        echo json_encode([
            'success' => false,
            'message' => "Extension $extension not found. Nothing to delete."
        ]);
        exit;
    }

    // Delete from DB
    $stmt = $conn->prepare("DELETE FROM extensions WHERE extension = ?");
    $stmt->bind_param("s", $extension);

    if (!$stmt->execute()) {
        http_response_code(500);
        echo json_encode([
            'success' => false,
            'message' => "DB delete failed: " . $stmt->error
        ]);
        exit;
    }
    $stmt->close();

    // Delete XML file
    if (file_exists($fs_path)) {
        if (!unlink($fs_path)) {
            // Rollback — re-insert into DB since file delete failed
            $existing = getExtension($conn, $extension);
            http_response_code(500);
            echo json_encode([
                'success'  => false,
                'message'  => "Failed to delete XML file for extension $extension. DB entry kept.",
                'rollback' => true
            ]);
            exit;
        }
    }

    // Reload FreeSWITCH
    $fs_reload = shell_exec("/bin/fs_cli_automax --port 8022 -x 'reloadxml' 2>&1");

    http_response_code(200);
    echo json_encode([
        'success'    => true,
        'message'    => "Extension $extension deleted successfully",
        'extension'  => $extension,
        'freeswitch' => trim($fs_reload)
    ]);
}

// ============================================
// INVALID ACTION
// ============================================
else {
    http_response_code(400);
    echo json_encode([
        'success' => false,
        'message' => "Invalid action. Use: create, update, delete"
    ]);
}
?>
